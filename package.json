{
  "name": "aprender-e-brincar",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "test:core": "node scripts/core-test.mjs",
    "audit:games": "node scripts/game-audit.mjs",
    "audit:child-interface": "node scripts/child-interface-audit.mjs",
    "audit:audio": "node scripts/audio-audit.mjs",
    "test:e2e": "npm run build && node scripts/e2e-test.mjs",
    "audio:coverage": "node scripts/audio-coverage.mjs",
    "prebuild": "node scripts/audio-index.mjs && node scripts/native-fingerprint.mjs",
    "test:play-all": "npm run build && node scripts/play-all.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "audit:legacy": "npm run build && node scripts/legacy-audit.mjs",
    "postbuild": "node scripts/stamp-sw.mjs",
    "audio:compress": "node scripts/compress-audio.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "voice:status": "node scripts/voice-status.mjs",
    "voice:import": "node scripts/voice-import.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-legacy": "^6.1.1",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "playwright": "1.56.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "terser": "^5.51.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource-variable/nunito": "^5.3.0"
  },
  "browserslist": [
    "defaults",
    "iOS >= 9",
    "Safari >= 9",
    "Android >= 5"
  ]
}
